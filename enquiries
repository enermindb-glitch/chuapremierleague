<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Enquiries — Chuka Premier League</title>
<link rel="stylesheet" href="styles.css">
</head>
<body>

<div id="nav-slot"></div>

<div class="wrap section" style="max-width:560px">
  <div class="section-head"><h2 class="mt-0">Contact Admin</h2></div>
  <p class="muted">Questions about registration, fixtures, transfers, or anything else — send a message and league admins will follow up.</p>

  <div id="enquiry-success" class="form-success">Message sent — an admin will get back to you.</div>

  <form id="enquiry-form">
    <div class="field">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required>
    </div>
    <div class="field">
      <label for="role">I am a</label>
      <select id="role" name="role" required>
        <option value="">Select one</option>
        <option>Player</option>
        <option>Team representative</option>
        <option>Referee</option>
        <option>Fan / Supporter</option>
        <option>Other</option>
      </select>
    </div>
    <div class="field">
      <label for="team">Team (if applicable)</label>
      <input type="text" id="team" name="team">
    </div>
    <div class="field">
      <label for="subject">Subject</label>
      <input type="text" id="subject" name="subject" required>
    </div>
    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Send message</button>
  </form>
</div>

<div id="footer-slot"></div>

<script src="config.js"></script>
<script src="nav.js"></script>
<script src="enquiries.js"></script>
</body>
</html>
